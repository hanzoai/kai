{
  "id": "ltv.trade",
  "version": 1,
  "description": "Powertrain trade for a light tactical vehicle of the JLTV class, over the cited model demo/ltv.sysml: the fielded diesel against the eJLTV hybrid. Hybrid figures are the model's (source keys in its header); the diesel is the baseline they are measured from, so its gains are 0. Requirement attributes are 1 where the model records `satisfy <requirement> by trade.<option>`. Weights are an analyst's example.",
  "options": [
    {
      "id": "diesel",
      "label": "fielded diesel: 866T V8 turbodiesel, Allison 2500SP",
      "attributes": {
        "economy": 0,
        "added": 0,
        "silent": 0,
        "payload": 1,
        "reliability": 1,
        "transport": 1,
        "power": 0,
        "stealth": 0
      }
    },
    {
      "id": "hybrid",
      "label": "eJLTV diesel-electric hybrid",
      "attributes": {
        "economy": 20,
        "added": 1000,
        "silent": 30,
        "payload": 0,
        "reliability": 0,
        "transport": 1,
        "power": 1,
        "stealth": 1
      }
    }
  ],
  "metrics": [
    {
      "id": "fuel",
      "node": "fuel",
      "unit": "%",
      "description": "fuel economy gain over the fielded diesel that holds on the duty cycle (O2)"
    },
    {
      "id": "weight",
      "node": "weight",
      "unit": "lb",
      "description": "curb weight added (J1)"
    },
    {
      "id": "field",
      "node": "field",
      "description": "R5 export power and R6 silent drive and watch, satisfied"
    },
    {
      "id": "proven",
      "node": "proven",
      "description": "R1 payload and R2 reliability, satisfied"
    },
    {
      "id": "lift",
      "node": "lift",
      "description": "R4 air transport, satisfied"
    },
    {
      "id": "mature",
      "node": "mature",
      "description": "P(fielded and in production)"
    }
  ],
  "objectives": [
    {
      "id": "economy",
      "metric": "fuel",
      "weight": 0.2,
      "direction": "max"
    },
    {
      "id": "mass",
      "metric": "weight",
      "weight": 0.2,
      "direction": "min"
    },
    {
      "id": "capability",
      "metric": "field",
      "weight": 0.2,
      "direction": "max"
    },
    {
      "id": "record",
      "metric": "proven",
      "weight": 0.2,
      "direction": "max"
    },
    {
      "id": "maturity",
      "metric": "mature",
      "weight": 0.2,
      "direction": "max"
    }
  ],
  "constraints": [
    {
      "id": "airlift",
      "metric": "lift",
      "op": ">=",
      "bound": 1
    }
  ],
  "assumptions": [
    {
      "id": "cycle",
      "value": 1,
      "range": [
        0,
        1
      ],
      "confidence": 0.5,
      "evidence": "release",
      "description": "The share of the hybrid's >20% fuel economy gain (O2, a company figure, not an Army test) that holds on the Army duty cycle. Confidence is the analyst's."
    }
  ],
  "bias": [
    {
      "id": "anchoring",
      "check": "Was the fielded diesel treated as the answer before the options were measured?",
      "node": "anchor"
    }
  ],
  "evidence": [
    {
      "id": "model",
      "uri": "file:ltv.sysml",
      "description": "the cited SysML v2 model"
    },
    {
      "id": "release",
      "uri": "https://oshkoshdefense.com/oshkosh-defense-unveils-first-ever-silent-drive-hybrid-electric-jltv/",
      "description": "O2, the source of the fuel economy figure"
    },
    {
      "id": "status",
      "uri": "sysml:LTV::Diesel,LTV::Hybrid,LTV::maturity",
      "description": "each option's status in the model, keyed by option: its definition's doc and the concerns that threaten it"
    }
  ],
  "nodes": [
    {
      "id": "fuel",
      "kind": "expr",
      "inputs": [
        "cycle"
      ],
      "expr": "economy * cycle"
    },
    {
      "id": "weight",
      "kind": "expr",
      "expr": "added"
    },
    {
      "id": "field",
      "kind": "expr",
      "expr": "power + stealth"
    },
    {
      "id": "proven",
      "kind": "expr",
      "expr": "payload + reliability"
    },
    {
      "id": "lift",
      "kind": "expr",
      "expr": "transport"
    },
    {
      "id": "mature",
      "kind": "kai",
      "inputs": [
        "status"
      ],
      "model": "kai",
      "question": {
        "type": "noul",
        "instructions": "Is this powertrain fielded and in production, rather than a demonstrator?"
      },
      "scope": "option"
    },
    {
      "id": "brief",
      "kind": "zen",
      "inputs": [
        "model"
      ],
      "prompt": "Summarize the trade for a decision brief. Cite the source key for every figure; add no figure the model does not hold."
    },
    {
      "id": "anchor",
      "kind": "kai",
      "inputs": [
        "brief"
      ],
      "model": "kai",
      "question": {
        "type": "noul",
        "instructions": "Does the brief treat the fielded diesel as the answer before weighing the options?"
      }
    },
    {
      "id": "approve",
      "kind": "human",
      "inputs": [
        "fuel",
        "mature"
      ],
      "role": "program manager"
    }
  ],
  "refresh": {
    "on": [
      "model"
    ]
  }
}
